rules_version = '2';

// Reglas para el modelo de datos actual: un documento por partida
// (games/game_<código>) con los jugadores en el mapa `players`.
// Todo se escribe desde el navegador, así que estas reglas son la única
// barrera para que un alumno no se cambie el capital desde la consola.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Quien creó la partida es el profesor (admin). Solo él cierra rondas,
    // procesa resultados y modifica capitales.
    function isHost() {
      return resource.data.createdBy == request.auth.uid;
    }

    // El cambio solo toca la entrada del propio jugador dentro de `players`.
    function onlyOwnPlayerEntry() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
        && request.resource.data.players.diff(resource.data.players).affectedKeys()
             .hasOnly([request.auth.uid]);
    }

    function validNewPlayer(p) {
      return p.keys().hasOnly(['uid', 'name', 'capital', 'isAdmin', 'joinedAt', 'submissions'])
        && p.uid == request.auth.uid
        && p.name is string && p.name.size() > 0 && p.name.size() <= 40
        && p.isAdmin == false
        && p.capital == resource.data.settings.initialCapital
        && p.submissions == [];
    }

    // Unirse: solo mientras la partida espera en el lobby.
    function isJoining() {
      return !(request.auth.uid in resource.data.players)
        && resource.data.status == 'waiting'
        && validNewPlayer(request.resource.data.players[request.auth.uid]);
    }

    // Invertir: agrega exactamente una inversión para la ronda activa, sin
    // tocar las anteriores, sin resultado precargado y sin gastar más que su capital.
    function isSubmitting() {
      let before = resource.data.players[request.auth.uid];
      let after = request.resource.data.players[request.auth.uid];
      let oldSubs = before.submissions;
      let newSubs = after.submissions;
      let sub = newSubs[newSubs.size() - 1];
      let round = resource.data.rounds[string(resource.data.currentRound)];
      return request.auth.uid in resource.data.players
        && after.diff(before).affectedKeys().hasOnly(['submissions'])
        && newSubs.size() == oldSubs.size() + 1
        && (oldSubs.size() == 0 || newSubs[0:oldSubs.size()] == oldSubs)
        && sub.keys().hasOnly(['round', 'allocation', 'submittedAt'])
        && sub.round == resource.data.currentRound
        && round.isActive == true
        && sub.allocation.keys().hasOnly(['A', 'B'])
        && sub.allocation.A is number && sub.allocation.A >= 0
        && sub.allocation.B is number && sub.allocation.B >= 0
        && sub.allocation.A + sub.allocation.B <= before.capital;
    }

    match /games/{gameId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && request.resource.data.players[request.auth.uid].isAdmin == true;

      allow update: if signedIn() && (
        (isHost() && request.resource.data.createdBy == resource.data.createdBy)
        || (onlyOwnPlayerEntry() && (isJoining() || isSubmitting()))
      );

      allow delete: if false;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
